{
  "name": "job-tracker",
  "version": "1.0.0",
  "description": "Scans your Gmail for LinkedIn job alert emails, enriches job details from public/ATS APIs, tailors your resume with AI, and tracks applications.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"node --watch server.js\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
